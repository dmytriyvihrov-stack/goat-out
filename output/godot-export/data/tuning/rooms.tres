[gd_resource type="Resource" script_class="RoomsTuning" format=3]

[ext_resource type="Script" path="res://data/classes/rooms_tuning.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
crateWant = [1, 3]
bossShut = {"on": true, "inset": 1.2}
armory = {"chance": 0.5, "from": 2, "crates": 1}
flank = {"chance": 0.6, "from": 2}
