midPillars = {"chance": 0.5, "minFloor": 110, "ground": 0.4, "near": 0.35, "shapes": [[[-2, 0], [2, 0]], [[0, -2], [0, 2]], [[-2, -2], [2, -2], [-2, 2], [2, 2]], [[-2, -1], [2, 1]], [[-3, 0], [0, 0], [3, 0]]]}
