[gd_resource type="Resource" script_class="QuestsTable" format=3]

[ext_resource type="Script" path="res://data/classes/quests_table.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
tortoise = {"name": "THE TORTOISE'S PACE", "color": "#8fae6a", "talisman": "tallow", "offer": "THEY CALL ME SLOW, AS IF IT WERE A WEAKNESS. I HAVE NEVER RUN FROM A FIGHT. I HAVE NEVER LOST ONE. | THE SECOND FLOOR. WHEN THEY COME CLOSE, FIGHT AT MY PACE. SLOW, HEAVY, SURE. WILL YOU?", "took": "SLOWLY, THEN. A SLOW FIGHT IS STILL A FIGHT WON.", "wear": "THE SECOND FLOOR. WHEN THEY COME CLOSE, FIGHT AT MY PACE. SLOW AND SURE.", "won": "YOU SEE IT NOW. SLOW IS NOT WEAK. I CAN REST. | TAKE THIS FROM ME: WHEN THEY CROWD YOU, HOLD THE ROLL AND BE A SHELL.", "off": "...ANOTHER TIME. SLOWLY.", "boon": "shell", "thanks": "YOU CARRIED ME OUT IN YOUR TEETH. NOBODY EVER CARRIED ME ANYWHERE. | THEY HAVE MORE CAGES DOWN THERE. I WILL BE IN ONE NEAR THE START OF A FLOOR. BRING ME OUT ONCE MORE.", "again": "NEAR THE START OF A FLOOR. ONCE MORE. SLOWLY.", "free": ["...", "I AM RESTING.", "NO HURRY. THERE NEVER WAS ANY."]}
goose = {"name": "THE GOOSE'S VOICE", "color": "#e8e2d0", "talisman": "bell", "offer": "HONK. YOU KNOW WHY I HONK AT EVERYONE? ...LATER. | THE THIRD FLOOR. CLIMB OUT OF IT WITH NOTHING BUT YOUR VOICE. NO HORNS, NO TEETH. SHOW ME A VOICE IS ENOUGH. WILL YOU?", "took": "HONK! NOTHING BUT BAAH ON THE THIRD!", "wear": "THE THIRD FLOOR. ONLY YOUR VOICE. NO HORNS, NO TEETH.", "won": "THEY ANSWERED! MY FLOCK! I HONKED AT EVERYONE BECAUSE NOBODY EVER HONKED BACK. NOW THEY DO.", "off": "HONK. COWARD.", "thanks": "HONK! OUT! AND I BIT NOBODY. ALMOST NOBODY. | MY FLOCK IS STILL IN THEIR COOPS. I WILL BE IN ONE NEAR THE START OF A FLOOR. GET ME OUT ONCE MORE.", "again": "HONK. NEAR THE START OF A FLOOR. ONCE MORE.", "free": ["HONK!", "HONK HONK! THEY ARE BACK TONIGHT!", "I WAS NEVER LONELY. I AM JUST LOUD."]}
horse = {"name": "THE HORSE'S CHASE", "color": "#c8743a", "talisman": "spur", "offer": "A REMATCH. I DO NOT LOSE TWICE. | NOW AND THEN THE RED WILL COME AFTER YOU DOWN THERE. NOBODY KNOWS ON WHICH FLOOR. OUTRUN IT ON {n} FLOORS. A BET?", "took": "IT IS A BET. RUN, GOAT.", "wear": "THE RED COMES AFTER YOU NOW AND THEN. {left} MORE FLOORS TO OUTRUN IT.", "won": "YOU OUTRAN THE RED. I NEVER DID. ...OPEN THE FENCE. I WANT TO RUN WHERE I LIKE.", "off": "NO BET? NEIGH. COWARD.", "thanks": "NEIGH. OUT OF THE STALL. THEY HAD ME TURNING THEIR WHEEL. ME. | THERE IS ANOTHER STALL DOWN THERE, NEAR THE START OF A FLOOR. FIND ME. WE RACE AGAIN.", "again": "NEAR THE START OF A FLOOR. WE RACE AGAIN.", "free": ["NEIGH!", "NO FENCE. NO TRACK. WHERE I LIKE.", "THE GOLD GRASS IS NOT BAD."]}
